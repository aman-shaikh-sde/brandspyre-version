# BRANDSPYRE Environment Configuration
# API Base URL - Normalize without trailing slash
VITE_API_URL=http://localhost:3000/api

# WebSocket Server URL - Normalize without trailing slash
VITE_SOCKET_URL=http://localhost:3000

# Razorpay Client-Side Key ID (Public key only; NEVER put Key Secret on frontend)
# Use rzp_test_... for test mode and rzp_live_... for production mode
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
