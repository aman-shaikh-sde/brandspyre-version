# =========================================================
# Brandspyre Sales Frontend (Marketplace) Environment Config
# =========================================================
# NOTE: Because Vite inlines VITE_* variables during build,
# make sure this file (or .env.production) exists BEFORE running 'npm run build'.

# 1. Backend Marketplace API URL
# If hosting sales frontend behind an Nginx reverse proxy that routes /api/ -> backend (Port 3000):
# VITE_API_URL=/api/marketplace
#
# If calling the backend directly across domains:
VITE_API_URL=https://api.brandspyre.in/api/marketplace

# 2. Main Authoritative ERP Link
# URL pointing to the main Brandspyre ERP platform (used in header and footer links)
VITE_BRANDSPYRE_ERP_URL=https://brandspyre.in
