    "partial_day_type": "morning"
  }
  Full-Day Leave Request
  {
    "staff_id": "BR01/01",            // optional if logged-in user is requesting for themselves
    "branchcode": "BR01",             // required
    "leave_type": "casual",           // required: must be 'sick', 'casual', or 'earned'
    "start_date": "2025-07-10",       // required: must be in 'YYYY-MM-DD' format
    "end_date": "2025-07-13",         // required
    "reason": "Attending family event" // optional (but recommended)
  }
  
