# Database Configuration
MONGODB_URI=mongodb://localhost:27017/brandspyre

# Authentication & JWT Secrets (Minimum 32 characters, generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long

# Initial Platform SuperAdmin Credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# Razorpay Payment Gateway (Server-Side Secrets ONLY)
# For Test Mode: Key ID starts with rzp_test_...
# For Live Mode: Key ID starts with rzp_live_...
# Webhook Secret: Configure the exact same secret in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Server Configuration
PORT=3000
NODE_ENV=development
TRUST_PROXY=1
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
SUPPORT_EMAIL=support@brandspyre.com

# AES-256 Field-Level Encryption Key (Mandatory in production, minimum 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_aes_256_encryption_key_min_32_chars_long

# Stripe Payment Gateway (Optional / Marketplace)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Zoho / SMTP Email Configuration
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM_NAME="Brandspyre CRM"
SMTP_FROM_EMAIL=your_email@domain.com

# Deployment Controls (Optional - Platform Admins Only)
RENDER_SERVICE_ID=your_render_service_id
RENDER_API_KEY=your_render_api_key

# Gemini / OpenAI AI API Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
